// src/main.pdx -- pdxsock v1.1-A/B real body (issues #15, #16).
//
// pdxsock: netcat-adjacent general TCP/UDP client + server. This file
// is the ring-3 ELF entry point (`_start`), argv-wired per the frozen
// execve ABI (design/user/execve-abi.md in the paideia-os monorepo):
//   rdi = argc, rsi = argv (VA of a char*[]), rdx = envp (unused),
//   rsp % 16 == 0 at entry.
//
// v1.1-A "retire M1-001 STUB body" scope (issue #15)
// --------------------------------------------------
// Replaces the M1-001 seed's placeholder body with a REAL syscall
// path. Wire coverage at this landing:
//
//   Client mode (`pdxsock <host> <port>`):
//     sys_socket(AF_INET=2, SOCK_STREAM=1, 0)  SC+ ID 87
//     sys_connect(fd, ip_u32, port)            SC+ ID 91
//     sys_read(0, buf, 4096)                   SC+ ID 0   -- one stdin gulp
//     sys_send(fd, buf, n)                     SC+ ID 92
//     loop: sys_recv(fd, buf, 4096)            SC+ ID 93
//           sys_write(1, buf, n)               SC+ ID 1
//           break when recv returns <= 0
//     sys_shutdown(fd, 2 = SHUT_RDWR)          SC+ ID 94
//     sys_exit(0)                              SC+ ID 60
//
//   Server mode (`pdxsock -l <port>`):
//     sys_socket(AF_INET=2, SOCK_STREAM=1, 0)  SC+ ID 87
//     sys_bind(fd, port)                       SC+ ID 88
//     sys_listen(fd, backlog=8)                SC+ ID 89
//     sys_accept(fd)                           SC+ ID 90  -> new fd
//     loop: sys_recv(new_fd, buf, 4096)        SC+ ID 93
//           sys_write(1, buf, n)               SC+ ID 1
//           break when recv returns <= 0
//     sys_shutdown(new_fd, 2)                  SC+ ID 94
//     sys_exit(0)                              SC+ ID 60
//
// v1.1-A' "bidirectional TCP client pump" scope (issue #4, M2-001)
// -----------------------------------------------------------------
// Replaces v1.1-A's HTTP-style client shape (one stdin gulp, one
// sys_send, then recv-to-stdout loop) with a real stdin->socket /
// socket->stdout blocking-alternation pump under pdxsock_pump_loop.
// Loop body per iteration: sys_read(0, buf, 4096); sys_send(fd,
// buf, n); sys_recv(fd, buf, 4096); sys_write(1, buf, n). Exit
// conditions: stdin EOF drops into pdxsock_pump_stdin_drain which
// reads the socket to peer-EOF and forwards to stdout (honest
// half-close drain, no SHUT_WR wired at this landing); socket EOF
// or any -errno on either sys_send / sys_recv drops into
// pdxsock_client_close which emits the M2-001 close-fingerprint
// band, then jmps to the v1.1-B shared semantic-pipe emit tail.
//
// Two grep-searchable fingerprint lines emitted on fd 2 (stderr,
// NOT fd 1 -- fd 1 is reserved for socket payload):
//   pdxsock tcp-client connect ok\n
//     Emitted immediately after sys_connect returns success and
//     BEFORE the pump loop enters -- proves the handshake landed
//     even on runs that block on stdin forever.
//   pdxsock tcp-client bytes-in=<N> bytes-out=<M>\n
//     Emitted right after pump-loop exit and BEFORE the v1.1-B
//     SockSessionRecord@0.1 emit. Wire-visible counterpart of the
//     semantic-pipe record's bytes_in / bytes_out fields; decimal
//     digits composed by an inline divide-by-10 loop (verbatim
//     `xor rdx, rdx; div rcx` shape from src/user/init.pdx and
//     src/user/ps.pdx, R17-M2-736 D12) against two 20-byte .bss
//     scratches (pdxsock_dec_scratch_in / pdxsock_dec_scratch_out;
//     u64::MAX = 20 decimal digits so the stashes never overrun).
//
// Design choice: blocking-alternation over sys_poll (SC+ ID 102,
// R95.M3-001 #2080). sys_poll's TCP RX wake wire is DEFERRED per
// the R95 retrospective; a blocking poll on a TCP fd would not
// resume when packets arrive, and non-blocking poll (timeout_ms=0)
// degenerates to a spin loop with no sched_yield surfaced. Task
// shape at M2-001 explicitly permits blocking-alternation; the
// honest scope is "request-response-shaped" TCP (each stdin blob
// prompts a socket response before the next stdin read), which
// matches every M4-001 echo-smoke witness planned at this
// milestone. True full-duplex re-lands once TCP RX wake or a
// non-blocking sys_read on stdin exists.
//
// The server body is UNCHANGED at v1.1-A' -- the M2-001 fingerprint
// band and pump loop are client-only surfaces. Server continues to
// jump straight to pdxsock_emit_session_and_exit on recv-loop exit.
//
// v1.1-B "semantic-pipe emission wire" scope (issue #16)
// -------------------------------------------------------
// Adds SockSessionRecord@0.1 emission at end of every completed
// connection (client or server), via sys_semantic_send (SC+ ID 115,
// paideia-os handler landed at R107-M0-001 #2350).
//
// Record shape (40 bytes, @align(8), fits in the sysno-115 240-byte
// per-slot cap with 200 bytes of headroom for future fields):
//
//   [ +0]  bytes_in         u64   -- socket->local octets (sys_recv sum)
//   [ +8]  bytes_out        u64   -- local->socket octets (sys_send sum);
//                                    always 0 in server mode at v1.1-B
//                                    (the server body writes stdout only)
//   [+16]  peer_ip_port_mode u64  -- packed:
//                                     bits [ 0..31] = peer_ip u32 (server=0
//                                                    since sys_accept at
//                                                    v1.1-A does not thread
//                                                    an out-address)
//                                     bits [32..47] = peer_port u16
//                                     bits [48..55] = mode      u8 (0=client,
//                                                                   1=server)
//                                     bits [56..63] = reserved  u8 (0)
//   [+24]  session_start_ns u64   -- rdtsc snapshot taken right AFTER
//                                    sys_connect (client) or sys_accept
//                                    (server) returns success
//   [+32]  session_end_ns   u64   -- rdtsc snapshot taken at recv-loop exit
//                                    (either EOF or -errno) just before
//                                    sys_semantic_send + sys_shutdown
//
// Timestamp caveat: at v1.1-B these are raw TSC samples (cycles), NOT
// nanoseconds. There is no user-facing sys_clock_now yet; the design
// name "_ns" is preserved for schema-shape stability across a future
// re-land that converts to ns once the syscall exists. Consumers can
// compute a monotonic duration = (end - start) TSC ticks; converting
// to wall-time ns needs a per-host TSC frequency the kernel does not
// yet publish. This mirrors src/kernel/core/fs/pdxfs_lite/write.pdx's
// "monotonic-lookalike (rdtsc sample)" precedent (R25-M2-005 #919).
//
// Schema tag: 0x536F636B53657301 -- an ASCII-mnemonic ("SockSes"+ver01)
// stable u64 fingerprint for SockSessionRecord@0.1 chosen ad-hoc at
// v1.1-B and preserved verbatim once paideia-os#2000 (schema registry)
// lands (the registry is additive over these constants). Grep-friendly
// per `design/networking/r100-user-tools-plan.md` §10 note that "every
// wave binds a schema fingerprint constant" pre-registry.
//
// No cap slot: sys_semantic_send takes no {cap} (kernel-side confirmed
// at src/kernel/core/syscall/handlers/sys_semantic_send.pdx line 158).
// KIND_IPC_ENDPOINT in caps.decl remains optional documentation for a
// future KIND_SEMANTIC_PIPE recv-side cap, not a v1.1-B admit gate.
//
// Emit points: exactly one record per completed connection. Failure
// paths BEFORE the recv loop (socket / connect / bind / listen /
// accept refusals, argv usage, bad port, bad ip) emit nothing -- there
// is no session to describe.
//
// UDP client + UDP server + --dry-run + stdin/socket full-duplex are
// DEFERRED to later issues on the pdxsock backlog:
//   - -u UDP client: pdxsock#6 (M3-001), unblocked by sysnos 96/97
//     (sendto/recvfrom, R93.M2-004 #2052). This body prints the
//     documented pdxsock_msg_udp_not_yet diagnostic and exits 3.
//   - -u -l UDP server: out of scope per design/networking/r100-user-
//     tools-plan.md §7.2 (needs recvfrom peer-address out-params which
//     the caller-side ABI at this round does not thread through libpdx-
//     net yet; UDP server would need a different tool shape).
//   - --dry-run: LANDED as an [Unreleased] change on top of v1.2.0
//     (pdxsock#3, M1-003). Leading-position `--dry-run` at argv[1]
//     is peeled at _start Step 0.5 and the flow enters the dedicated
//     dry-run classifier (pdxsock_dry_run_entry) which prints
//     `pdxsock dry-run mode=<M> target=<H>:<P>\n` on fd 1 and
//     sys_exit(0) without opening any socket. Positional-flexibility
//     (--dry-run at any argv index) deferred -- may be subsumed by
//     the M1-002 argv scanner move (pdxsock#2).
//   - Bidirectional stdin/socket forwarding: LANDED at v1.1-A'
//     (pdxsock#4, M2-001) as blocking-alternation over sys_read(0)
//     and sys_recv(fd). See the v1.1-A' scope block above for the
//     "why blocking-alternation instead of sys_poll" note; true
//     full-duplex (concurrent stdin+socket traffic) re-lands once
//     TCP RX wake or a non-blocking sys_read on stdin exists.
//
// Argv grammar accepted at this landing (matches design §7.1 subset):
//     pdxsock <host> <port>       -- TCP client
//     pdxsock -l <port>           -- TCP server
//     pdxsock -u <host> <port>    -- UDP client (STUB refuses; exit 3)
//     pdxsock -l -u <port>        -- UDP server (out of scope; exit 3)
//     pdxsock                     -- usage on fd 2; exit 2
//     pdxsock <anything else>     -- usage on fd 2; exit 2
//
// Encoder discipline (paideia-as 0.36+ pitfalls, per user memory)
// ---------------------------------------------------------------
//   - No `test rN, rN` anywhere; every zero-check is `cmp rN, 0`.
//   - No 2-op `imul r, imm`; decimal *10 is `shl rax, 3; add rax, r10;
//     add rax, r10` (rax*8 + rax + rax = rax*10). The `parse_u64_body`
//     inline block below is the only place a *10 fold happens.
//   - Byte loads via `xor rax, rax; mov_b rax, [ptr]` per src/user/
//     cat.pdx (paideia-as #1248: cmp al, imm8 emits with REX.W so
//     the upper bits of rax must be zero before the byte compare
//     observes the loaded byte cleanly).
//   - Every label prefixed `pdxsock_` (paideia-as reserved-word
//     discipline: `loop`, `if` etc. are keywords and bare labels
//     using them fail to parse).
//   - Module name = PascalCase file basename (`Main` for `main.pdx`).
//   - No multiline `pub let = "..."` string continuations; every
//     literal is one line.
//   - No `and r11, imm64`; every mask fits in imm32.
//   - Fingerprint tag sizes: byte-array declarations write the NUL
//     into the length AND the string body, but the sys_write length
//     constant is the wire byte count (no NUL). Every literal below
//     names both explicitly (`_len` sibling constant).
//
// SC+ IDs used (matches src/user/syscall_shim.pdx + design/user/
// syscall-table.md through sysno 115):
//   0   = sys_read          (fd, buf, count)         -> n | -errno
//   1   = sys_write         (fd, buf, count)         -> n | -errno
//   60  = sys_exit          (status)                 -> never returns
//   87  = sys_socket        (domain, type, proto)    -> fd | -errno
//   88  = sys_bind          (fd, local_port)         -> 0 | -errno
//   89  = sys_listen        (fd, backlog)            -> 0 | -errno
//   90  = sys_accept        (fd)                     -> new fd | -errno
//   91  = sys_connect       (fd, remote_ip, port)    -> 0 | -errno
//   92  = sys_send          (fd, buf, len)           -> n | -errno
//   93  = sys_recv          (fd, buf, len)           -> n | -errno
//   94  = sys_shutdown      (fd, how)                -> 0 | -errno
//   115 = sys_semantic_send (schema, rec_ptr, rec_len) -> 0 | -errno   (v1.1-B)
//
// The kernel's real bind/connect ABI is the "collapsed" shape
// (`local_port` u64, `remote_ip` u32 packed dotted-quad in bits
// [31:0]) -- design/user/syscall-table.md's `sockaddr_ptr` prose is
// aspirational; src/kernel/core/syscall/handlers/sys_bind.pdx and
// sys_connect.pdx are the ground truth and this file targets those.
// remote_ip byte order: bits [31:24]=a, [23:16]=b, [15:8]=c, [7:0]=d
// for "a.b.c.d" (matches sys_connect.pdx's own header note).

module Main = structure {

  // -----------------------------------------------------------------
  // 4 KiB scratch buffer -- one page, matches sys_read/sys_recv's
  // natural transfer sweet spot. .bss, uninit, 8-byte aligned.
  // -----------------------------------------------------------------
  pub let mut pdxsock_buf : [u8; 4096] = uninit @align(8)

  // -----------------------------------------------------------------
  // Diagnostic messages. Every literal is one line; `_len` is the
  // wire byte count (excludes the trailing NUL). Byte counts audited
  // by hand -- paideia-as errors any mismatch between the declared
  // [u8; N] and the literal length, and a mismatch between the
  // sys_write count and the actual wire bytes silently overruns the
  // buffer into adjacent .rodata (see user memory `pdx encoder
  // pitfalls`: fingerprint tag size off-by-one).
  //
  // The v1.1-A messages are intentionally terse (fixed vocabulary,
  // one line each) so the audit is a two-second scan; a richer usage
  // string with grammar and mode-flag hints lands with pdxsock#2
  // (M1-002 argv surface).
  // -----------------------------------------------------------------
  pub let pdxsock_msg_usage         : [u8; 16] = "pdxsock: usage\n\0"
  pub let pdxsock_msg_usage_len     : u64 = 15

  pub let pdxsock_msg_bad_port      : [u8; 19] = "pdxsock: bad port\n\0"
  pub let pdxsock_msg_bad_port_len  : u64 = 18

  pub let pdxsock_msg_bad_ip        : [u8; 17] = "pdxsock: bad ip\n\0"
  pub let pdxsock_msg_bad_ip_len    : u64 = 16

  pub let pdxsock_msg_udp_not_yet   : [u8; 19] = "pdxsock: udp stub\n\0"
  pub let pdxsock_msg_udp_not_yet_len : u64 = 18

  pub let pdxsock_msg_socket_fail   : [u8; 22] = "pdxsock: socket fail\n\0"
  pub let pdxsock_msg_socket_fail_len : u64 = 21

  pub let pdxsock_msg_connect_fail  : [u8; 23] = "pdxsock: connect fail\n\0"
  pub let pdxsock_msg_connect_fail_len : u64 = 22

  pub let pdxsock_msg_bind_fail     : [u8; 20] = "pdxsock: bind fail\n\0"
  pub let pdxsock_msg_bind_fail_len : u64 = 19

  pub let pdxsock_msg_listen_fail   : [u8; 22] = "pdxsock: listen fail\n\0"
  pub let pdxsock_msg_listen_fail_len : u64 = 21

  pub let pdxsock_msg_accept_fail   : [u8; 22] = "pdxsock: accept fail\n\0"
  pub let pdxsock_msg_accept_fail_len : u64 = 21

  // -----------------------------------------------------------------
  // v1.2-x --dry-run preview strings (issue #3, M1-003).
  //
  // Wire format of the preview line (one sys_write chain, no scratch
  // buffer): `pdxsock dry-run mode=<M> target=<H>:<P>\n` where <M> is
  // one of the fixed 10-byte mode names below, <H> is either the argv
  // host string (client modes) or the literal `0.0.0.0` (server modes
  // -- honest placeholder for the "we would bind INADDR_ANY" fact),
  // and <P> is the raw argv port string (not parsed at dry-run time --
  // the point is to preview what the tool WOULD do, and re-parsing
  // adds a failure surface that the real run would already exhibit).
  //
  // Chained-sys_write vs. compose-then-write: the preview line's
  // variable-length parts (host, port) are pointers into argv, so a
  // compose-into-scratch pass would need two strlen loops PLUS a copy
  // pass; a 7-sys_write chain (prefix, mode, target-kw, host-or-any,
  // colon, port, newline) is smaller code AND avoids the pdxsock_buf
  // touch (the 4 KiB scratch page is exclusively socket-side data
  // under v1.1-A / v1.1-B; a --dry-run that leaves it untouched keeps
  // that invariant honest).
  //
  // Each mode name is exactly 10 bytes on the wire so the mode-write
  // block picks the pointer via a chain of `cmp r14, K; je ...` and
  // uses a single shared `mov rdx, 10; mov rax, 1; syscall` tail.
  // -----------------------------------------------------------------
  pub let pdxsock_msg_dry_prefix       : [u8; 22] = "pdxsock dry-run mode=\0"
  pub let pdxsock_msg_dry_prefix_len   : u64      = 21

  pub let pdxsock_msg_mode_tcp_client  : [u8; 11] = "tcp-client\0"
  pub let pdxsock_msg_mode_tcp_server  : [u8; 11] = "tcp-server\0"
  pub let pdxsock_msg_mode_udp_client  : [u8; 11] = "udp-client\0"
  pub let pdxsock_msg_mode_udp_server  : [u8; 11] = "udp-server\0"
  pub let pdxsock_msg_mode_name_len    : u64      = 10

  pub let pdxsock_msg_target_kw        : [u8; 9]  = " target=\0"
  pub let pdxsock_msg_target_kw_len    : u64      = 8

  pub let pdxsock_msg_addr_any         : [u8; 8]  = "0.0.0.0\0"
  pub let pdxsock_msg_addr_any_len     : u64      = 7

  pub let pdxsock_msg_colon            : [u8; 2]  = ":\0"
  pub let pdxsock_msg_colon_len        : u64      = 1

  pub let pdxsock_msg_newline          : [u8; 2]  = "\n\0"
  pub let pdxsock_msg_newline_len      : u64      = 1

  // -----------------------------------------------------------------
  // v1.1-A' full-duplex TCP client fingerprints (issue #4, M2-001).
  //
  // Two grep-searchable status lines emitted on fd 2 (stderr) that
  // frame every TCP client run:
  //
  //   pdxsock tcp-client connect ok\n
  //     Emitted immediately after sys_connect returns success and
  //     before the pump loop enters -- lets the caller (a shell
  //     smoke, a test harness) confirm the TCP handshake landed
  //     without waiting for the pump loop to close.
  //
  //   pdxsock tcp-client bytes-in=<N> bytes-out=<M>\n
  //     Emitted right after the pump loop exits (either side EOF)
  //     and before the v1.1-B SockSessionRecord@0.1 semantic-pipe
  //     emit -- the wire-visible counterpart of the semantic-pipe
  //     record's bytes_in / bytes_out fields. Decimal digits are
  //     composed by an inline divide-by-10 loop against two 20-byte
  //     .bss scratches (pdxsock_dec_scratch_in/out); u64::MAX is
  //     20 decimal digits so the scratch never overruns.
  //
  // Fingerprints go to fd 2 (stderr), NOT fd 1: pdxsock's stdout is
  // reserved for the socket payload the peer sent, and a status line
  // interleaved into that stream would corrupt every downstream
  // consumer that pipes pdxsock into something (e.g. `pdxsock host
  // port | grep pattern`). This mirrors the diagnostic-vs-payload
  // split every existing pdxsock_msg_*_fail line already uses.
  // -----------------------------------------------------------------
  pub let pdxsock_msg_connect_ok       : [u8; 31] = "pdxsock tcp-client connect ok\n\0"
  pub let pdxsock_msg_connect_ok_len   : u64      = 30

  pub let pdxsock_msg_close_prefix     : [u8; 29] = "pdxsock tcp-client bytes-in=\0"
  pub let pdxsock_msg_close_prefix_len : u64      = 28

  pub let pdxsock_msg_close_mid        : [u8; 12] = " bytes-out=\0"
  pub let pdxsock_msg_close_mid_len    : u64      = 11

  // -----------------------------------------------------------------
  // v1.1-B semantic-pipe record buffer + supporting state (issue #16).
  //
  // pdxsock_record_buf holds the marshalled SockSessionRecord@0.1
  // (40 bytes, layout in the file header). @align(8) so every u64
  // store is naturally aligned. .bss-resident (uninit); every field is
  // overwritten at emit time, so the initial contents are irrelevant.
  //
  // pdxsock_session_start_ns caches the rdtsc snapshot taken right
  // after sys_connect (client) / sys_accept (server) returns success,
  // so the emit block can read it back into a register without holding
  // it in a scarce callee-save across the entire recv loop. .bss with
  // = 0 initializer (matches src/kernel/core/syscall/handlers/
  // sys_semantic_send.pdx's _semantic_ring_head declaration).
  //
  // pdxsock_schema_sock_session is the schema fingerprint the kernel
  // stores verbatim into the ring slot's schema u64. Grep-searchable
  // constant; see the file header for the ASCII-mnemonic derivation.
  // -----------------------------------------------------------------
  pub let mut pdxsock_record_buf         : [u8; 40] = uninit @align(8)
  pub let mut pdxsock_session_start_ns   : u64      = 0
  pub let pdxsock_schema_sock_session    : u64      = 0x536F636B53657301

  // -----------------------------------------------------------------
  // v1.1-A' close-fingerprint decimal scratches (issue #4, M2-001).
  //
  // Two 20-byte .bss regions -- one per numeric field on the close
  // fingerprint line -- into which the divide-by-10 loop stashes the
  // ASCII digits of bytes_in and bytes_out right-to-left. 20 bytes
  // covers u64::MAX = 18446744073709551615 (20 digits), so the
  // stash never overruns even at the theoretical bandwidth ceiling.
  //
  // Two separate scratches (rather than one reused) so the emit
  // sequence is prefix-then-write-then-prefix-then-write with no
  // reset between them; a shared scratch would need a re-init step
  // between the two encodings, which is cheap but adds a failure
  // surface (an off-by-one in the reset would silently emit the
  // trailing digits of bytes_in as part of bytes_out). Cost is 40
  // bytes of .bss -- negligible for a static tool this size.
  //
  // The scratch layout is caller-only: no other code reads or
  // writes these bytes, and the divide-by-10 loop overwrites every
  // used byte on entry (the fingerprint is composed once per run,
  // right before sys_exit, so re-entry does not exist).
  // -----------------------------------------------------------------
  pub let mut pdxsock_dec_scratch_in     : [u8; 20] = uninit @align(8)
  pub let mut pdxsock_dec_scratch_out    : [u8; 20] = uninit @align(8)

  // -----------------------------------------------------------------
  // _start -- pdxsock entry point. Never returns; every terminal path
  // ends in sys_exit.
  //
  // Register plan (all callee-save, so they survive every syscall
  // without push/pop -- SYSCALL preserves callee-save regs by the
  // amd64 fast-syscall convention):
  //   r12 = argc     (Step 0..argv parse) then bytes_in accumulator (v1.1-B)
  //   r13 = argv base (Step 0..argv parse) then bytes_out accumulator (v1.1-B)
  //   r14 = mode flag                  (0=client, 1=server, 2=UDP-client stub)
  //   r15 = fd                         (from sys_socket / sys_accept)
  //   rbx = parsed port                (0..65535); also carried into the
  //                                     v1.1-B emit record
  //   rbp = peer_ip u32 (v1.1-B; 0 in server mode). Callee-save; @no_frame
  //         means the function does not use rbp as a frame pointer, so
  //         it is free for our own use.
  //
  // r12/r13 flip-role at the entry to pdxsock_client_body /
  // pdxsock_server_body: they are re-initialised to 0 there, since
  // their argv-time contents are no longer needed after the mode has
  // been picked. rbp is written once (in the client body, from the
  // ip-parser's r9 output; xor'd to 0 in the server body) and read
  // once (at emit time).
  //
  // Exit statuses:
  //   0 = clean completion (a normal end-of-stream on either side)
  //   2 = argv usage refusal
  //   3 = capability not yet wired at v1.1-A (UDP stub)
  //   4 = sys_socket refused
  //   5 = sys_connect refused (client) / sys_bind refused (server)
  //   6 = sys_listen refused
  //   7 = sys_accept refused
  //   8 = bad port
  //   9 = bad IPv4
  //
  // Effects: {mem, sysreg} for scratch touches + every SYSCALL.
  // Caps:    @{fs, sched, cap} -- fs for read/write, sched for exit,
  //          cap for the socket-syscall family (all cap-gated on the
  //          kernel side per src/kernel/core/syscall/handlers/
  //          sys_socket.pdx et al).
  // -----------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched, cap},
      justification: "pdxsock v1.1-A M1-001 real body (issue #15) + v1.1-B semantic-pipe emission wire (issue #16). Retires the M1-001 STUB with a REAL syscall path over the R72.M1-005 socket family (sysnos 87..94) plus sys_read/write/exit (0/1/60), and at v1.1-B additionally emits SockSessionRecord@0.1 via sys_semantic_send (SC+ ID 115, R107-M0-001 #2350) at the end of every completed TCP connection (both client and server paths). Argv dispatch: (a) argc == 3 with argv[1] == '-l' -> TCP server (bind/listen/accept/recv/write/emit/shutdown/exit). (b) argc == 3 without a leading flag -> TCP client (connect/read-stdin/send/recv/write/emit/shutdown/exit). (c) argc == 4 with argv[1] == '-u' -> UDP-client stub (write diagnostic, exit 3). (d) argc == 4 with argv[1] == '-l' and argv[2] == '-u' -> UDP-server refusal (out of scope per design/networking/r100-user-tools-plan.md §7.2; same exit-3 diagnostic). (e) anything else -> usage on fd 2, exit 2. Every parse failure (bad IP, bad port) emits its own diagnostic and exits nonzero without touching a socket. Every syscall refusal (socket / connect / bind / listen / accept) emits its own diagnostic on fd 2 and exits with a distinct nonzero status so the caller can tell them apart -- and emits NO SockSessionRecord (no session to describe). v1.1-B session-accounting state: r12=bytes_in (u64 accum over sys_recv returns), r13=bytes_out (u64 accum over sys_send returns; server=0), rbp=peer_ip (u32; server=0), rbx=port carried from parse, r14=mode, r15=fd; pdxsock_session_start_ns @ .bss caches an rdtsc snapshot taken post-connect (client) / post-accept (server); pdxsock_record_buf (40B, @align(8)) marshals {bytes_in, bytes_out, peer_ip|port|mode packed, session_start_ns, session_end_ns} before the sysno-115 call. Timestamp caveat: session_{start,end}_ns are raw TSC ticks not ns until sys_clock_now lands -- schema-shape stable, precedent src/kernel/core/fs/pdxfs_lite/write.pdx (R25-M2-005 #919). Register discipline (revised for v1.1-B): r12/r13 flip from argc/argv (argv-parse phase) to bytes_in/bytes_out (post-parse phase); rbp is newly used as peer_ip and is legitimate under @no_frame (function is leaf-adjacent, never returns). All state carried in callee-save registers survives every SYSCALL by the amd64 fast-syscall convention. rcx and r11 are SYSCALL-clobbered per that same convention; the emit block uses them only for record-field assembly BEFORE each syscall, never reads them after. sys_semantic_send's return (0 / -EFAULT / -EINVAL) is intentionally discarded: the connection is over, and a failure here is a marshalling bug in this file (40-byte record within the [1,240] cap, static rip-relative record_ptr never fails user_ptr_ok) rather than a per-run condition the caller can act on. Encoder discipline (per user memory `pdx encoder pitfalls`): no `test rN, rN` (every zero-check is `cmp rN, 0`); no 2-op `imul r, imm` (decimal *10 is `shl rax, 3; add rax, r10; add rax, r10`); byte loads use `xor rax, rax; mov_b rax, [ptr]`; module name matches file basename PascalCase (Main); every label prefixed `pdxsock_`. New encoder patterns exercised by v1.1-B: `rdtsc` + `shl rdx, 32` + `or rax, rdx` (TSC reconstruction, proven at src/kernel/core/fs/pdxfs_lite/uuid.pdx); `mov [rip + label], reg` and `mov reg, [rip + label]` (rip-relative u64 stores/loads, proven at sys_semantic_send.pdx line 214); `mov r64, imm64` movabs for the 8-byte schema constant (proven at sys_semantic_send.pdx line 221 for errno constants); `add r64, r64` accumulation into r12/r13.",
      block: {
        // ---- Step 0: latch argc / argv from execve-ABI registers. ----
        mov r12, rdi;                           // r12 = argc
        mov r13, rsi;                           // r13 = argv

        // ---- Step 0.5: --dry-run flag peel (issue #3, M1-003). ----------
        //
        // If argc >= 2 and argv[1] is exactly the byte sequence
        // "--dry-run\0" (10 bytes including the terminating NUL), peel
        // the flag by shifting r13 forward one argv slot and decrementing
        // r12 -- the classifier that follows then sees the invocation
        // as if the flag were absent, and jumps into pdxsock_dry_run_
        // entry instead of the normal argc-gate. Detection is leading-
        // position only at this landing (issue #3 scope); a positional-
        // flexibility landing that accepts `--dry-run` mixed in with
        // `-l`/`-u` at any argv index is deferred to a follow-on M1
        // issue if the argv scanner move (M1-002 / #2) does not
        // subsume it.
        //
        // Byte-by-byte inline compare rather than a strcmp helper: this
        // file has no other `pub let` function (every path is inline
        // label code under _start), so introducing a callable helper
        // just for this 10-byte match would need a new top-level `pub
        // let` shape and a `call` encoding this codebase does not yet
        // exercise. The inline compare touches rbx (argv[1] base ptr)
        // and rax (per-byte scratch) which the argc-gate below re-
        // initialises anyway.
        //
        // Read-past-NUL safety: argv strings are NUL-terminated per
        // the execve ABI, so a shorter-than-9 argv[1] terminates the
        // compare early on the NUL mismatch (byte 0..8 vs. their
        // expected bytes; the NUL byte will not equal any of the
        // expected characters). A longer argv[1] whose first 9 bytes
        // happen to be "--dry-run" but has a trailing character (e.g.
        // "--dry-runX") fails the byte-9 NUL check and falls through.
        cmp r12, 2;
        jl pdxsock_no_dry;
        mov rbx, [r13 + 8];                     // rbx = argv[1]
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0x2d;                           // '-'
        jne pdxsock_no_dry;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x2d;                           // '-'
        jne pdxsock_no_dry;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0x64;                           // 'd'
        jne pdxsock_no_dry;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 0x72;                           // 'r'
        jne pdxsock_no_dry;
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 0x79;                           // 'y'
        jne pdxsock_no_dry;
        xor rax, rax;
        mov_b rax, [rbx + 5];
        cmp rax, 0x2d;                           // '-'
        jne pdxsock_no_dry;
        xor rax, rax;
        mov_b rax, [rbx + 6];
        cmp rax, 0x72;                           // 'r'
        jne pdxsock_no_dry;
        xor rax, rax;
        mov_b rax, [rbx + 7];
        cmp rax, 0x75;                           // 'u'
        jne pdxsock_no_dry;
        xor rax, rax;
        mov_b rax, [rbx + 8];
        cmp rax, 0x6e;                           // 'n'
        jne pdxsock_no_dry;
        xor rax, rax;
        mov_b rax, [rbx + 9];
        cmp rax, 0;                              // NUL terminator
        jne pdxsock_no_dry;
        // Matches. Shift argv+8, decrement argc, and enter dry-run flow.
        sub r12, 1;
        add r13, 8;
        jmp pdxsock_dry_run_entry;

      pdxsock_no_dry:
        // ---- Step 1: argc gate. -----------------------------------------
        cmp r12, 3;
        je pdxsock_check_argc3;
        cmp r12, 4;
        je pdxsock_check_argc4;
        jmp pdxsock_usage;

      pdxsock_check_argc3:
        // argc == 3: either `pdxsock <host> <port>` (client) or
        //           `pdxsock -l <port>` (server).
        // Peek argv[1]: is it "-l"?
        mov rbx, [r13 + 8];                    // rbx = argv[1]
        xor rax, rax;
        mov_b rax, [rbx];
        cmp rax, 0x2d;                           // '-'
        jne pdxsock_client_mode;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x6c;                           // 'l'
        jne pdxsock_usage;                       // '-' followed by non-'l' -> usage
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0;                              // NUL after 'l'?
        jne pdxsock_usage;                       // "-l..." with trailer -> usage
        // "-l" detected -> server mode on argv[2] port.
        mov r14, 1;                              // mode = server
        mov rdi, [r13 + 16];                    // rdi = argv[2] = port_str
        jmp pdxsock_parse_port;

      pdxsock_check_argc4:
        // argc == 4: `pdxsock -u <host> <port>` (UDP client stub) or
        //            `pdxsock -l -u <port>` (UDP server refusal).
        // Peek argv[1]: '-l' or '-u'?
        mov rbx, [r13 + 8];                    // rbx = argv[1]
        xor rax, rax;
        mov_b rax, [rbx];
        cmp rax, 0x2d;                           // '-'
        jne pdxsock_usage;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x75;                           // 'u'
        je pdxsock_argv4_u;
        cmp rax, 0x6c;                           // 'l'
        je pdxsock_argv4_l;
        jmp pdxsock_usage;

      pdxsock_argv4_u:
        // "-u ..." at argv[1]. Ensure NUL after 'u'.
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0;
        jne pdxsock_usage;
        // UDP client stub -- emit diagnostic and exit 3 (no socket touched).
        jmp pdxsock_udp_stub;

      pdxsock_argv4_l:
        // "-l ..." at argv[1]. Ensure NUL after 'l'.
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0;
        jne pdxsock_usage;
        // Peek argv[2]: expect "-u" for the UDP server refusal path.
        mov rbx, [r13 + 16];
        xor rax, rax;
        mov_b rax, [rbx];
        cmp rax, 0x2d;
        jne pdxsock_usage;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x75;
        jne pdxsock_usage;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0;
        jne pdxsock_usage;
        // "-l -u <port>" -- UDP server. Out of scope per §7.2. Same
        // diagnostic + exit 3 as the UDP client stub (both are the
        // "UDP not yet wired at v1.1-A" surface).
        jmp pdxsock_udp_stub;

      pdxsock_client_mode:
        // argc == 3 with no leading flag: `pdxsock <host> <port>`.
        mov r14, 0;                              // mode = client
        mov rdi, [r13 + 16];                    // port_str = argv[2]
        jmp pdxsock_parse_port;

        // ================================================================
        // Diagnostic exits
        // ================================================================

      pdxsock_usage:
        mov rdi, 2;                              // fd = stderr
        lea rsi, [rip + pdxsock_msg_usage];
        mov rdx, 15;                             // pdxsock_msg_usage_len
        mov rax, 1;                              // SC+ ID 1 = sys_write
        syscall;
        mov rdi, 2;                              // exit status = 2 (usage)
        mov rax, 60;
        syscall;
        hlt;

      pdxsock_udp_stub:
        mov rdi, 2;
        lea rsi, [rip + pdxsock_msg_udp_not_yet];
        mov rdx, 18;                             // pdxsock_msg_udp_not_yet_len
        mov rax, 1;
        syscall;
        mov rdi, 3;                              // exit status = 3
        mov rax, 60;
        syscall;
        hlt;

      pdxsock_bad_port:
        mov rdi, 2;
        lea rsi, [rip + pdxsock_msg_bad_port];
        mov rdx, 18;                             // pdxsock_msg_bad_port_len
        mov rax, 1;
        syscall;
        mov rdi, 8;                              // exit status = 8
        mov rax, 60;
        syscall;
        hlt;

      pdxsock_bad_ip:
        mov rdi, 2;
        lea rsi, [rip + pdxsock_msg_bad_ip];
        mov rdx, 16;                             // pdxsock_msg_bad_ip_len
        mov rax, 1;
        syscall;
        mov rdi, 9;                              // exit status = 9
        mov rax, 60;
        syscall;
        hlt;

      pdxsock_socket_fail:
        mov rdi, 2;
        lea rsi, [rip + pdxsock_msg_socket_fail];
        mov rdx, 21;                             // pdxsock_msg_socket_fail_len
        mov rax, 1;
        syscall;
        mov rdi, 4;
        mov rax, 60;
        syscall;
        hlt;

      pdxsock_connect_fail:
        mov rdi, 2;
        lea rsi, [rip + pdxsock_msg_connect_fail];
        mov rdx, 22;                             // pdxsock_msg_connect_fail_len
        mov rax, 1;
        syscall;
        mov rdi, 5;
        mov rax, 60;
        syscall;
        hlt;

      pdxsock_bind_fail:
        mov rdi, 2;
        lea rsi, [rip + pdxsock_msg_bind_fail];
        mov rdx, 19;                             // pdxsock_msg_bind_fail_len
        mov rax, 1;
        syscall;
        mov rdi, 5;
        mov rax, 60;
        syscall;
        hlt;

      pdxsock_listen_fail:
        mov rdi, 2;
        lea rsi, [rip + pdxsock_msg_listen_fail];
        mov rdx, 21;                             // pdxsock_msg_listen_fail_len
        mov rax, 1;
        syscall;
        mov rdi, 6;
        mov rax, 60;
        syscall;
        hlt;

      pdxsock_accept_fail:
        mov rdi, 2;
        lea rsi, [rip + pdxsock_msg_accept_fail];
        mov rdx, 21;                             // pdxsock_msg_accept_fail_len
        mov rax, 1;
        syscall;
        mov rdi, 7;
        mov rax, 60;
        syscall;
        hlt;

        // ================================================================
        // Port parser -- inline decimal accumulator.
        //   rdi = char* NUL-terminated port string
        //   rbx <- parsed port (0..65535); on failure jumps to pdxsock_bad_port.
        // Uses rcx as byte cursor, r8 as scratch byte, r10 as *10 helper.
        // rdi survives (not touched); rax is destroyed.
        // ================================================================

      pdxsock_parse_port:
        xor rax, rax;                            // acc = 0
        xor rcx, rcx;                            // i = 0
      pdxsock_port_loop:
        xor r8, r8;
        mov_b r8, [rdi + rcx*1];                 // byte = str[i]
        cmp r8, 0;                               // NUL?
        je pdxsock_port_done;
        sub r8, 48;                              // '0' = 48
        cmp r8, 9;
        ja pdxsock_bad_port;                     // non-digit -> refuse
        // acc = acc * 10 + digit  (via shl+add+add, per encoder-discipline
        // note: 2-op `imul r, imm` is banned).
        mov r10, rax;                            // r10 = acc
        shl rax, 3;                              // rax = acc*8
        add rax, r10;                            // + acc  = *9
        add rax, r10;                            // + acc  = *10
        add rax, r8;                             // + digit
        add rcx, 1;
        jmp pdxsock_port_loop;
      pdxsock_port_done:
        // Range gate: 0..65535 (u16). Reject empty string (rcx == 0)
        // and overflows (rax > 65535).
        cmp rcx, 0;
        je pdxsock_bad_port;
        cmp rax, 65535;
        ja pdxsock_bad_port;
        mov rbx, rax;                            // rbx = port

        // Fork on mode.
        cmp r14, 1;
        je pdxsock_server_body;
        cmp r14, 0;
        je pdxsock_client_parse_ip;
        // Unreachable (mode==2 was consumed by pdxsock_udp_stub above).
        jmp pdxsock_usage;

        // ================================================================
        // IPv4 parser -- accepts "a.b.c.d", NUL-terminated, each field
        //   0..255, exactly three dots. Writes u32 to r9 in the byte
        //   order sys_connect expects (bits [31:24]=a, [23:16]=b,
        //   [15:8]=c, [7:0]=d per sys_connect.pdx header).
        //   Input:  argv[1] as the host string.
        //   Output: r9 = ip_u32 on success; jumps to pdxsock_bad_ip
        //           on any malformed field, embedded NUL, or over-255.
        // Uses rdi as base ptr (argv[1]), rcx as byte cursor, r8/r10
        //   as inner scratches, rdx as running u32 accumulator.
        // ================================================================

      pdxsock_client_parse_ip:
        mov rdi, [r13 + 8];                    // host = argv[1]
        xor rdx, rdx;                            // rdx = accumulated u32
        xor rcx, rcx;                            // rcx = cursor
        xor r11, r11;                            // r11 = dot count (0..3)
      pdxsock_ip_field:
        xor rax, rax;                            // per-field accumulator
        xor r15, r15;                            // per-field digit count
      pdxsock_ip_digit_loop:
        xor r8, r8;
        mov_b r8, [rdi + rcx*1];
        cmp r8, 0;                               // NUL ends the string (only valid after 4th field)
        je pdxsock_ip_field_end_nul;
        cmp r8, 0x2e;                            // '.'
        je pdxsock_ip_field_end_dot;
        sub r8, 48;
        cmp r8, 9;
        ja pdxsock_bad_ip;
        mov r10, rax;
        shl rax, 3;
        add rax, r10;
        add rax, r10;
        add rax, r8;
        cmp rax, 255;                            // per-field cap (fits in u8)
        ja pdxsock_bad_ip;
        add rcx, 1;
        add r15, 1;
        // Cap per-field digit count at 3 to reject leading-zero abuse and
        // guarantee no false-positive overflow past the 255 gate above.
        cmp r15, 3;
        ja pdxsock_bad_ip;
        jmp pdxsock_ip_digit_loop;
      pdxsock_ip_field_end_dot:
        // Field ended with '.'. Empty field (r15 == 0) is invalid.
        cmp r15, 0;
        je pdxsock_bad_ip;
        // Fold this field into the u32 accumulator (rdx = (rdx << 8) | field).
        shl rdx, 8;
        add rdx, rax;
        add r11, 1;
        cmp r11, 3;                              // already saw 3 dots?
        ja pdxsock_bad_ip;
        add rcx, 1;                              // skip the '.'
        jmp pdxsock_ip_field;
      pdxsock_ip_field_end_nul:
        // Field ended with NUL. Empty field (r15 == 0) is invalid.
        cmp r15, 0;
        je pdxsock_bad_ip;
        // Must have seen exactly 3 dots before this NUL.
        cmp r11, 3;
        jne pdxsock_bad_ip;
        shl rdx, 8;
        add rdx, rax;
        mov r9, rdx;                             // r9 = ip_u32
        // Fall through to the client body.

        // ================================================================
        // TCP client body.
        //   rbx = port, r9 = ip_u32.
        // ================================================================

      pdxsock_client_body:
        // ---- sys_socket(AF_INET=2, SOCK_STREAM=1, 0). SC+ ID 87. ----
        mov rdi, 2;                              // AF_INET
        mov rsi, 1;                              // SOCK_STREAM
        xor rdx, rdx;                            // proto = 0
        mov rax, 87;
        syscall;
        cmp rax, 0;
        jl pdxsock_socket_fail;
        mov r15, rax;                            // r15 = fd

        // v1.1-B: latch peer_ip into callee-save rbp BEFORE sys_connect,
        // since sys_connect's SYSCALL scratches r9 (caller-save). rbp
        // survives every subsequent syscall and is read once at emit
        // time; the ip-parser's r9 output would otherwise not reach the
        // emit block.
        mov rbp, r9;                             // peer_ip -> rbp

        // ---- sys_connect(fd, ip_u32, port). SC+ ID 91. ----
        mov rdi, r15;
        mov rsi, rbp;                            // remote_ip (from rbp)
        mov rdx, rbx;                            // remote_port
        mov rax, 91;
        syscall;
        cmp rax, 0;
        jl pdxsock_connect_fail;

        // v1.1-A' (issue #4, M2-001): emit "pdxsock tcp-client connect
        // ok\n" fingerprint on fd 2 immediately after handshake success,
        // BEFORE the pump loop enters. Lets a smoke or shell caller
        // observe "the socket is open and connected" without having to
        // wait for the pump loop's first EOF -- a run that connects and
        // then blocks on stdin forever (e.g. interactive netcat-shaped
        // use) still surfaces the connect-ok proof of life.
        mov rdi, 2;                              // fd = stderr
        lea rsi, [rip + pdxsock_msg_connect_ok];
        mov rdx, 30;                             // pdxsock_msg_connect_ok_len
        mov rax, 1;                              // sys_write
        syscall;

        // v1.1-B: session accounting starts NOW (post-connect success).
        // r12 = bytes_in, r13 = bytes_out (both u64 accumulators over the
        // life of the connection). rdtsc snapshot into
        // pdxsock_session_start_ns (see file header on the ns / TSC-tick
        // caveat -- schema-shape stable, semantics are cycle counts).
        xor r12, r12;                            // bytes_in  = 0
        xor r13, r13;                            // bytes_out = 0
        rdtsc;                                   // EDX:EAX = TSC
        shl rdx, 32;                             // reconstruct u64 in rax
        or rax, rdx;
        mov [rip + pdxsock_session_start_ns], rax;

        // v1.1-A' (issue #4, M2-001) bidirectional pump.
        //
        // Replaces v1.1-A's HTTP-style shape (one stdin gulp, one
        // sys_send, recv-to-stdout loop) with a real
        // stdin->socket / socket->stdout blocking-alternation loop.
        //
        // Design choice: blocking-alternation over poll-based select.
        // sys_poll (sysno 102, R95.M3-001 #2080) exists BUT its TCP RX
        // wake wire is DEFERRED per the R95 retrospective -- a blocking
        // poll on a TCP fd would not resume when packets arrive.
        // Non-blocking poll (timeout_ms=0) would work but degenerates
        // to a spin loop since there is no sys_sched_yield surfaced at
        // this landing. The task shape explicitly permits blocking-
        // alternation, so that is what we do; the honest scope is
        // "request-response-shaped" TCP (each stdin blob prompts a
        // socket response before we look at stdin again), which
        // matches every M4-001 echo-smoke witness planned at this
        // milestone. Full-duplex forwarding for truly concurrent
        // stdin+socket traffic re-lands once TCP RX wake or a
        // non-blocking sys_read on stdin exists.
        //
        // Loop body:
        //   1. sys_read(fd=0, buf, 4096)
        //        rax > 0 -> sys_send that many bytes to the socket
        //        rax == 0 -> stdin EOF, break to drain-only tail
        //        rax < 0 -> stdin error, exit clean via emit block
        //   2. sys_recv(fd=sock, buf, 4096)
        //        rax > 0 -> sys_write to stdout
        //        rax <= 0 -> socket EOF or error, exit via emit block
        //   3. jmp back to step 1.
        //
        // Byte accounting is placed BEFORE each corresponding sys_write /
        // sys_send return-use so a subsequent write error does not skip
        // the count (the record and the close-fingerprint are about the
        // socket-side traffic, not the stdout path). bytes_out is only
        // incremented on send success (rax >= 0).
        //
        // Register discipline: r12 (bytes_in), r13 (bytes_out), r14 (mode),
        // r15 (fd), rbx (port), rbp (peer_ip) are all callee-save; every
        // syscall preserves them. rax/rcx/rdx/rsi/rdi/r8/r9/r10/r11 are
        // freely scratched.

      pdxsock_pump_loop:
        // ---- Step 1: sys_read(0, buf, 4096). SC+ ID 0. ----
        xor rdi, rdi;                            // fd = 0 (stdin)
        lea rsi, [rip + pdxsock_buf];
        mov rdx, 4096;
        mov rax, 0;
        syscall;
        cmp rax, 0;
        je pdxsock_pump_stdin_drain;             // stdin EOF -> switch to recv-only
        jl pdxsock_client_close;                 // stdin error -> clean close

        // ---- sys_send(fd, buf, n). SC+ ID 92. ----
        mov rdx, rax;                            // len = n
        mov rdi, r15;                            // fd
        lea rsi, [rip + pdxsock_buf];
        mov rax, 92;
        syscall;
        cmp rax, 0;
        jl pdxsock_client_close;                 // send failed -> close
        add r13, rax;                            // bytes_out += n

        // ---- Step 2: sys_recv(fd, buf, 4096). SC+ ID 93. ----
        mov rdi, r15;
        lea rsi, [rip + pdxsock_buf];
        mov rdx, 4096;
        mov rax, 93;
        syscall;
        cmp rax, 0;
        jle pdxsock_client_close;                // socket EOF or error -> close
        add r12, rax;                            // bytes_in += n

        // ---- sys_write(1, buf, n). SC+ ID 1. ----
        mov rdx, rax;
        mov rdi, 1;                              // fd = stdout
        lea rsi, [rip + pdxsock_buf];
        mov rax, 1;
        syscall;

        jmp pdxsock_pump_loop;

        // ---- Stdin-EOF tail: drain the socket until IT eofs. ----
        //
        // Reached when the local process's stdin closes (e.g. a shell
        // pipeline's producer finished writing). The peer may still
        // have unsent bytes queued; we continue reading them and
        // forwarding to stdout until the peer's side closes too. We do
        // NOT sys_shutdown the write half here at v1.1-A' -- a future
        // landing wires SHUT_WR (SC+ ID 94 with how=1) so the peer sees
        // a clean half-close, but every kernel-side smoke at this
        // milestone runs the read-drain to peer-EOF and does not
        // require the half-close signal.
      pdxsock_pump_stdin_drain:
        mov rdi, r15;
        lea rsi, [rip + pdxsock_buf];
        mov rdx, 4096;
        mov rax, 93;                             // sys_recv
        syscall;
        cmp rax, 0;
        jle pdxsock_client_close;                // socket EOF -> emit + exit
        add r12, rax;                            // bytes_in += n
        mov rdx, rax;
        mov rdi, 1;
        lea rsi, [rip + pdxsock_buf];
        mov rax, 1;
        syscall;
        jmp pdxsock_pump_stdin_drain;

        // ================================================================
        // v1.1-A' TCP-client close tail. Emits the bytes-in/bytes-out
        // fingerprint line to fd 2, then falls into the v1.1-B shared
        // semantic-pipe emit + sys_shutdown + sys_exit tail.
        //
        // Only the client path reaches here; the server path jumps
        // straight to pdxsock_emit_session_and_exit (server sockets do
        // not emit the "tcp-client" fingerprint line, which is a
        // client-only surface).
        //
        // Register discipline: r12 (bytes_in), r13 (bytes_out) are read
        // twice each (once into r9 for each divide-by-10 loop). rbx
        // (port), rbp (peer_ip), r14 (mode), r15 (fd) all survive
        // through to the shared emit block. rax/rcx/rdx/r9/r10/r11 are
        // scratched. Every SYSCALL below trashes r11/rcx but neither is
        // read after its issuing syscall.
        //
        // Wire format:
        //   pdxsock tcp-client bytes-in=<N> bytes-out=<M>\n
        //
        // Emission is a chain of six sys_writes (prefix, in-digits,
        // mid, out-digits, newline; the two digit-emits each write
        // exactly the [first_digit_ptr, len] slice their divide-by-10
        // loop leaves in [r11, computed_len]). Composing the whole
        // line into a scratch buffer would need a copy pass on top of
        // the two divide-by-10 loops; the chain is smaller code and
        // needs no extra .bss beyond the two 20-byte digit stashes
        // already declared at module scope.
        // ================================================================

      pdxsock_client_close:
        // ---- write(2, "pdxsock tcp-client bytes-in=", 28) ----
        mov rdi, 2;                              // fd = stderr
        lea rsi, [rip + pdxsock_msg_close_prefix];
        mov rdx, 28;                             // pdxsock_msg_close_prefix_len
        mov rax, 1;
        syscall;

        // ---- divide-by-10 loop: bytes_in (r12) -> pdxsock_dec_scratch_in. ----
        //
        // Right-to-left fill starting at scratch+19. r9 = remaining value,
        // r11 = cursor. Zero fast-path emits a single '0' digit and
        // jumps past the loop. On loop exit, r11 points at the first
        // (most significant) digit; length = (scratch + 20) - r11.
        mov r9, r12;                             // r9 = bytes_in
        lea r11, [rip + pdxsock_dec_scratch_in];
        add r11, 19;                             // cursor at last stash byte
        cmp r9, 0;
        jne pdxsock_dec_in_loop;
          // Zero fast-path.
          mov al, 0x30;                          // '0'
          mov [r11], al;
          mov rdi, 2;
          mov rsi, r11;
          mov rdx, 1;
          mov rax, 1;
          syscall;
          jmp pdxsock_dec_in_done;

      pdxsock_dec_in_loop:
        mov rax, r9;
        mov rcx, 10;
        xor rdx, rdx;                            // zero-extend for div
        div rcx;                                 // rax = quot, rdx = rem
        add rdx, 0x30;                           // digit -> ASCII
        mov [r11], dl;
        mov r9, rax;
        cmp r9, 0;
        je pdxsock_dec_in_emit;
        sub r11, 1;                              // advance cursor left
        jmp pdxsock_dec_in_loop;

      pdxsock_dec_in_emit:
        // r11 = first-digit pointer. Length = (scratch + 20) - r11.
        mov rdi, 2;
        mov rsi, r11;
        lea rax, [rip + pdxsock_dec_scratch_in];
        add rax, 20;
        sub rax, r11;                            // rax = digit count
        mov rdx, rax;
        mov rax, 1;
        syscall;

      pdxsock_dec_in_done:
        // ---- write(2, " bytes-out=", 11) ----
        mov rdi, 2;
        lea rsi, [rip + pdxsock_msg_close_mid];
        mov rdx, 11;                             // pdxsock_msg_close_mid_len
        mov rax, 1;
        syscall;

        // ---- divide-by-10 loop: bytes_out (r13) -> pdxsock_dec_scratch_out. ----
        mov r9, r13;                             // r9 = bytes_out
        lea r11, [rip + pdxsock_dec_scratch_out];
        add r11, 19;
        cmp r9, 0;
        jne pdxsock_dec_out_loop;
          mov al, 0x30;
          mov [r11], al;
          mov rdi, 2;
          mov rsi, r11;
          mov rdx, 1;
          mov rax, 1;
          syscall;
          jmp pdxsock_dec_out_done;

      pdxsock_dec_out_loop:
        mov rax, r9;
        mov rcx, 10;
        xor rdx, rdx;
        div rcx;
        add rdx, 0x30;
        mov [r11], dl;
        mov r9, rax;
        cmp r9, 0;
        je pdxsock_dec_out_emit;
        sub r11, 1;
        jmp pdxsock_dec_out_loop;

      pdxsock_dec_out_emit:
        mov rdi, 2;
        mov rsi, r11;
        lea rax, [rip + pdxsock_dec_scratch_out];
        add rax, 20;
        sub rax, r11;
        mov rdx, rax;
        mov rax, 1;
        syscall;

      pdxsock_dec_out_done:
        // ---- write(2, "\n", 1) ----
        mov rdi, 2;
        lea rsi, [rip + pdxsock_msg_newline];
        mov rdx, 1;
        mov rax, 1;
        syscall;

        // Jump to the v1.1-B shared semantic-pipe emit tail. Explicit
        // jump rather than fall-through: the label immediately below
        // in source order is pdxsock_server_body (the TCP server
        // dispatch entry), NOT pdxsock_emit_session_and_exit. A
        // fall-through here would silently re-enter the server body
        // with client-side registers, opening a second socket and
        // reissuing bind/listen against port r14. The explicit jump
        // preserves label-order flexibility for future refactoring.
        jmp pdxsock_emit_session_and_exit;

        // ================================================================
        // TCP server body.
        //   rbx = port.
        // ================================================================

      pdxsock_server_body:
        // ---- sys_socket(AF_INET=2, SOCK_STREAM=1, 0). SC+ ID 87. ----
        mov rdi, 2;
        mov rsi, 1;
        xor rdx, rdx;
        mov rax, 87;
        syscall;
        cmp rax, 0;
        jl pdxsock_socket_fail;
        mov r15, rax;                            // r15 = listen fd

        // ---- sys_bind(fd, port). SC+ ID 88. ----
        mov rdi, r15;
        mov rsi, rbx;                            // port
        mov rax, 88;
        syscall;
        cmp rax, 0;
        jl pdxsock_bind_fail;

        // ---- sys_listen(fd, 8). SC+ ID 89. ----
        mov rdi, r15;
        mov rsi, 8;                              // backlog
        mov rax, 89;
        syscall;
        cmp rax, 0;
        jl pdxsock_listen_fail;

        // ---- sys_accept(fd). SC+ ID 90. Blocks. ----
        mov rdi, r15;
        mov rax, 90;
        syscall;
        cmp rax, 0;
        jl pdxsock_accept_fail;
        mov r15, rax;                            // r15 = accepted fd (listen fd is closed by loop-exit anyway)

        // v1.1-B: session accounting starts NOW (post-accept success).
        // Server mode has no peer_ip / peer_port at v1.1-A (sys_accept
        // does not thread an out-address; a future recvfrom / accept
        // out-param wave lands them). rbp = 0 makes the emitted record
        // honest -- consumers can distinguish server records by mode==1
        // + peer_ip==0 without a separate presence flag.
        xor rbp, rbp;                            // peer_ip = 0 (server mode)
        xor r12, r12;                            // bytes_in  = 0
        xor r13, r13;                            // bytes_out = 0 (server v1.1-A never sys_sends)
        rdtsc;
        shl rdx, 32;
        or rax, rdx;
        mov [rip + pdxsock_session_start_ns], rax;

      pdxsock_server_recv_loop:
        // ---- sys_recv(fd, buf, 4096). SC+ ID 93. ----
        mov rdi, r15;
        lea rsi, [rip + pdxsock_buf];
        mov rdx, 4096;
        mov rax, 93;
        syscall;
        cmp rax, 0;
        jle pdxsock_emit_session_and_exit;

        // v1.1-B: bytes_in += n. Same rationale as the client-side add.
        add r12, rax;

        // ---- sys_write(1, buf, n). SC+ ID 1. ----
        mov rdx, rax;
        mov rdi, 1;
        lea rsi, [rip + pdxsock_buf];
        mov rax, 1;
        syscall;

        jmp pdxsock_server_recv_loop;

        // ================================================================
        // v1.1-B shared tail: emit SockSessionRecord@0.1 via sys_semantic_send
        //   (SC+ ID 115), then sys_shutdown + sys_exit(0). Reached from the
        //   client and server recv loops on EOF / -errno.
        //
        //   Live callee-save state on entry:
        //     r12 = bytes_in  (u64)
        //     r13 = bytes_out (u64)
        //     r14 = mode      (0=client, 1=server)
        //     r15 = fd        (for sys_shutdown)
        //     rbx = port      (u16 in low bits; upper zeros)
        //     rbp = peer_ip   (u32 in low bits; upper zeros; 0 in server)
        //     pdxsock_session_start_ns @ .bss holds the rdtsc snapshot
        //         captured post-connect / post-accept.
        //
        //   Scratch (all caller-save; freely trashed):
        //     rax, rdx      -- rdtsc destinations
        //     r10           -- record-buffer base
        //     r11, rcx      -- packed-qword assembly
        //     rdi, rsi, rdx -- sys_semantic_send / sys_shutdown / sys_exit args
        //     rcx, r11      -- SYSCALL-clobbered (documented; not read past
        //                      each syscall).
        //
        //   The record is marshalled BEFORE the sys_semantic_send call, so
        //   the syscall's r11/rcx clobber is invisible to the emit sequence.
        //   sys_semantic_send's return value (0 / -EFAULT / -EINVAL) is
        //   intentionally ignored -- the connection is over, and a failure
        //   at this layer is a marshalling bug in this file, not a per-run
        //   condition the caller can act on.
        // ================================================================

      pdxsock_emit_session_and_exit:
        // ---- session_end_ns via rdtsc reconstruction. ----
        rdtsc;                                   // EDX:EAX = TSC
        shl rdx, 32;
        or rax, rdx;                             // rax = session_end_ns (TSC ticks)

        // ---- Marshal the 40-byte SockSessionRecord@0.1. ----
        lea r10, [rip + pdxsock_record_buf];
        mov [r10 + 0], r12;                      // bytes_in
        mov [r10 + 8], r13;                      // bytes_out

        // Pack peer_ip (low 32) | port (bits 32..47) | mode (bits 48..55).
        mov r11, rbx;                            // r11 = port
        shl r11, 32;                             // -> bits 32..47 (upper zeros)
        mov rcx, r14;                            // rcx = mode
        shl rcx, 48;                             // -> bits 48..55
        or r11, rcx;
        or r11, rbp;                             // OR in peer_ip (low 32)
        mov [r10 + 16], r11;                     // packed qword

        // session_start_ns -> [+24]. Load from .bss into a scratch reg
        // first; paideia-as does not encode mem-to-mem moves.
        mov r11, [rip + pdxsock_session_start_ns];
        mov [r10 + 24], r11;
        mov [r10 + 32], rax;                     // session_end_ns

        // ---- sys_semantic_send(schema, record_ptr, record_len). SC+ ID 115. ----
        mov rdi, 0x536F636B53657301;             // schema tag (SockSessionRecord@0.1)
        lea rsi, [rip + pdxsock_record_buf];
        mov rdx, 40;                             // record_len (fits in [1, 240])
        mov rax, 115;
        syscall;

        // ---- sys_shutdown(fd, 2 = SHUT_RDWR). SC+ ID 94. ----
        mov rdi, r15;
        mov rsi, 2;
        mov rax, 94;
        syscall;

        // ---- sys_exit(0). SC+ ID 60. ----
        xor rdi, rdi;
        mov rax, 60;
        syscall;
        hlt;

        // ================================================================
        // v1.2-x --dry-run flow (issue #3, M1-003).
        //
        // Entered exclusively via `jmp pdxsock_dry_run_entry` from the
        // Step 0.5 flag peel. On entry:
        //   r12 = argc  (post-peel; original argc minus 1)
        //   r13 = argv+8 (post-peel; effective argv[0] = original argv[1]
        //                 = "--dry-run"; effective argv[1..] = original
        //                 argv[2..])
        //
        // Mode-classification decision tree (mirrors the socket-side
        // pdxsock_check_argc3 / pdxsock_check_argc4 tree, but never
        // opens a socket; every terminal path composes the preview line
        // and sys_exit(0)):
        //
        //   r12 == 3:
        //     effective argv[1] starts with '-' ?
        //       yes -> must be exactly "-l\0" -> tcp-server, port =
        //              effective argv[2]
        //              (any other leading-'-' -> usage / exit 2)
        //       no  -> tcp-client, host = effective argv[1], port =
        //              effective argv[2]
        //   r12 == 4:
        //     effective argv[1] starts with '-' ?
        //       no  -> usage / exit 2 (positional client accepts 2 args
        //              exactly; a bare third argv position is unknown
        //              at this milestone)
        //       yes -> byte-1 = 'u' -> "-u\0" -> udp-client, host =
        //              effective argv[2], port = effective argv[3]
        //              byte-1 = 'l' -> "-l\0" -> expect effective
        //              argv[2] == "-u\0" -> udp-server, port =
        //              effective argv[3]
        //              (any other -> usage / exit 2)
        //   any other argc -> usage / exit 2
        //
        // Mode encoding on r14: 0 = tcp-client, 1 = tcp-server,
        // 2 = udp-client, 3 = udp-server. Distinct from the socket-side
        // r14 usage (which only ever holds 0 or 1) because the dry-run
        // flow never enters pdxsock_udp_stub / pdxsock_client_body /
        // pdxsock_server_body -- the two r14 encodings never coexist
        // in one invocation.
        //
        // Host / port pointer registers on entry to pdxsock_dry_print:
        //   rbp = host_str ptr (only read for client modes -- r14 == 0
        //         or r14 == 2)
        //   r15 = port_str ptr (read for every mode)
        // Both callee-save; survive every sys_write in the chain.
        //
        // The 4 KiB pdxsock_buf and the 40-byte pdxsock_record_buf are
        // intentionally NOT touched at dry-run time -- a --dry-run
        // invocation leaves every socket-side scratch structure at its
        // .bss zero state, making the "we did not run" claim observable
        // at the memory level (matches the R100 plan §13.6 intent that
        // --dry-run be a pure preview, not a partial run).
        // ================================================================

      pdxsock_dry_run_entry:
        cmp r12, 3;
        je pdxsock_dry_argc3;
        cmp r12, 4;
        je pdxsock_dry_argc4;
        jmp pdxsock_usage;

      pdxsock_dry_argc3:
        mov rbx, [r13 + 8];                     // effective argv[1]
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0x2d;                           // '-'
        jne pdxsock_dry_tcp_client;
        // Leading '-': must be exactly "-l\0" (tcp-server). Any other
        // "-X" or "-l..." with a trailer is a usage refusal at dry-run
        // just as it is at the real-run classifier.
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x6c;                           // 'l'
        jne pdxsock_usage;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0;                              // NUL after 'l'
        jne pdxsock_usage;
        // "-l <port>" -- tcp-server.
        mov r14, 1;
        mov r15, [r13 + 16];                    // port_str = effective argv[2]
        jmp pdxsock_dry_print;

      pdxsock_dry_tcp_client:
        // "<host> <port>" -- tcp-client. host = argv[1] (already in rbx),
        // port = argv[2].
        mov r14, 0;
        mov rbp, rbx;
        mov r15, [r13 + 16];
        jmp pdxsock_dry_print;

      pdxsock_dry_argc4:
        mov rbx, [r13 + 8];                     // effective argv[1]
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0x2d;                           // '-'
        jne pdxsock_usage;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x75;                           // 'u'
        je pdxsock_dry_argc4_u;
        cmp rax, 0x6c;                           // 'l'
        je pdxsock_dry_argc4_l;
        jmp pdxsock_usage;

      pdxsock_dry_argc4_u:
        // "-u <host> <port>" -- udp-client.
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0;                              // NUL after 'u'
        jne pdxsock_usage;
        mov r14, 2;
        mov rbp, [r13 + 16];                    // host = effective argv[2]
        mov r15, [r13 + 24];                    // port = effective argv[3]
        jmp pdxsock_dry_print;

      pdxsock_dry_argc4_l:
        // "-l -u <port>" -- udp-server refusal (kept as an explicit
        // dry-run preview so operators can confirm the shape they
        // typed classifies as they expect, even though the real-run
        // form of this invocation exits 3 with "udp stub").
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0;                              // NUL after 'l'
        jne pdxsock_usage;
        mov rbx, [r13 + 16];                    // effective argv[2]
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0x2d;                           // '-'
        jne pdxsock_usage;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x75;                           // 'u'
        jne pdxsock_usage;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0;                              // NUL after 'u'
        jne pdxsock_usage;
        mov r14, 3;
        mov r15, [r13 + 24];                    // port = effective argv[3]
        jmp pdxsock_dry_print;

        // ================================================================
        // Dry-run preview writer.
        //   r14 = mode  (0 = tcp-client, 1 = tcp-server,
        //                2 = udp-client, 3 = udp-server)
        //   rbp = host_str (client modes only; ignored for server modes)
        //   r15 = port_str (every mode)
        //
        // Emits exactly one line on fd 1:
        //   `pdxsock dry-run mode=<M> target=<H>:<P>\n`
        // via a 7-sys_write chain. Then sys_exit(0) -- no socket touched,
        // no semantic-pipe record emitted (dry-run leaves the record
        // ring untouched too; this is a preview, not a session).
        //
        // strlen loops for the argv host/port strings are inlined here
        // (no other `pub let` function in this file to house them; the
        // extra ~12 lines per loop is cheaper than a new function
        // shape and its call/ret encoding). Both loops trust the
        // execve-ABI NUL termination of argv strings.
        // ================================================================

      pdxsock_dry_print:
        // ---- write(1, "pdxsock dry-run mode=", 21) ----
        mov rdi, 1;
        lea rsi, [rip + pdxsock_msg_dry_prefix];
        mov rdx, 21;
        mov rax, 1;
        syscall;

        // ---- write(1, mode_str, 10) ----
        // Pick the mode pointer via a chain of cmp/je. mode == 3 falls
        // through to pdxsock_dry_write_mode with rsi still pointing at
        // udp-server (the last lea sets it).
        lea rsi, [rip + pdxsock_msg_mode_tcp_client];
        cmp r14, 0;
        je pdxsock_dry_write_mode;
        lea rsi, [rip + pdxsock_msg_mode_tcp_server];
        cmp r14, 1;
        je pdxsock_dry_write_mode;
        lea rsi, [rip + pdxsock_msg_mode_udp_client];
        cmp r14, 2;
        je pdxsock_dry_write_mode;
        lea rsi, [rip + pdxsock_msg_mode_udp_server];
        // fall through (mode == 3)

      pdxsock_dry_write_mode:
        mov rdi, 1;
        mov rdx, 10;                             // pdxsock_msg_mode_name_len
        mov rax, 1;
        syscall;

        // ---- write(1, " target=", 8) ----
        mov rdi, 1;
        lea rsi, [rip + pdxsock_msg_target_kw];
        mov rdx, 8;
        mov rax, 1;
        syscall;

        // ---- write(1, host_or_any, len) ----
        // Server modes (r14 == 1 or r14 == 3) emit the literal
        // "0.0.0.0" -- an honest INADDR_ANY placeholder. Client modes
        // strlen the argv host string and emit it verbatim.
        cmp r14, 1;
        je pdxsock_dry_host_any;
        cmp r14, 3;
        je pdxsock_dry_host_any;
        // Client mode: inline strlen on rbp -> rcx.
        xor rcx, rcx;
      pdxsock_dry_host_strlen:
        xor rax, rax;
        mov_b rax, [rbp + rcx*1];
        cmp rax, 0;
        je pdxsock_dry_host_write;
        add rcx, 1;
        jmp pdxsock_dry_host_strlen;
      pdxsock_dry_host_write:
        mov rdi, 1;
        mov rsi, rbp;
        mov rdx, rcx;
        mov rax, 1;
        syscall;
        jmp pdxsock_dry_after_host;
      pdxsock_dry_host_any:
        mov rdi, 1;
        lea rsi, [rip + pdxsock_msg_addr_any];
        mov rdx, 7;                              // pdxsock_msg_addr_any_len
        mov rax, 1;
        syscall;

      pdxsock_dry_after_host:
        // ---- write(1, ":", 1) ----
        mov rdi, 1;
        lea rsi, [rip + pdxsock_msg_colon];
        mov rdx, 1;
        mov rax, 1;
        syscall;

        // ---- write(1, port_str, strlen(port_str)) ----
        // Inline strlen on r15 -> rcx.
        xor rcx, rcx;
      pdxsock_dry_port_strlen:
        xor rax, rax;
        mov_b rax, [r15 + rcx*1];
        cmp rax, 0;
        je pdxsock_dry_port_write;
        add rcx, 1;
        jmp pdxsock_dry_port_strlen;
      pdxsock_dry_port_write:
        mov rdi, 1;
        mov rsi, r15;
        mov rdx, rcx;
        mov rax, 1;
        syscall;

        // ---- write(1, "\n", 1) ----
        mov rdi, 1;
        lea rsi, [rip + pdxsock_msg_newline];
        mov rdx, 1;
        mov rax, 1;
        syscall;

        // ---- sys_exit(0) ----
        xor rdi, rdi;
        mov rax, 60;
        syscall;
        hlt
      }
    } @no_frame
}
